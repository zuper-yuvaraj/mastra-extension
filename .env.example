OPENAI_API_KEY=

# --- RCA (root-cause analysis of workflow executions) ---
# Which engine answers POST /zuper/chat:
#   pipeline (default) | hydrated (whole workflow + every node's data in one pack; see src/mastra/rca/README.md)
# Anything else goes straight to the tool-using investigator. Restart the server after changing it.
RCA_ENGINE=pipeline

# Hydrated engine models. Model ids are written as openai/<model-id>. Defaults are shown; set only to override.
# The model that reads the pack and answers (it also writes the final structured answer):
# RCA_ANALYSIS_MODEL=openai/gpt-5.1
# RCA_ANALYSIS_EFFORT=medium        # none | low | medium | high: lower is faster and cheaper
# RCA_STRUCTURING_EFFORT=low
# The small call that summarises what a workflow is for (cached per workflow version):
# RCA_UNDERSTAND_MODEL=openai/gpt-5.1
# RCA_UNDERSTAND_EFFORT=low

# Older investigator and pipeline. Also the fallback when the hydrated engine cannot build its pack.
# RCA_MODEL=openai/gpt-5-mini
# RCA_STRUCTURING_MODEL=            # defaults to RCA_MODEL
# RCA_REASONING_EFFORT=low
