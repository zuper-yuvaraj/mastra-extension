{"id":"work-order-management/assets/create-asset-action","area":"work-order-management","module":"assets","title":"Create Asset Action","method":"POST","path":"/assets/{asset_uid}/actions","description":"Records an action against an asset (e.g. INSTALL, REMOVE, REPLACE, a status change). This is what populates Asset History. `REPLACE` creates two history rows: a REMOVE on this asset and an INSTALL on `meta_data.replaced_asset`.","params":[{"name":"asset_uid","in":"path","required":true,"type":"string","description":""}],"requestBody":{"fieldPaths":["action","action.action_type","action.job","action.customer","action.organization","action.product","action.meta_data","action.meta_data.replaced_serial_number","action.meta_data.replaced_asset","action.meta_data.replaced_product","action.meta_data.updated_status","action.property","action.attachments","action.attachments[].attachment_name","action.attachments[].attachment","action.attachments[].attachment_type","action.attachments[].attachment_size","action.remove_from_customer"],"example":null},"response":{"status":"200","fieldPaths":["type","message"],"example":{"type":"success","message":"Asset action added successfully"}},"associations":[],"sourceFile":"work-order-management/assets/create-asset-action.md"}